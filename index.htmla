<!doctype html>
<html lang="so">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TAMAL Exchange</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--red:#d71920;--ink:#171b26;--muted:#758092;--bg:#f4f6fa;--line:#e6eaf0;--white:#fff;--green:#138653}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px Arial,sans-serif}button,input,select,textarea{font:inherit}button{border:0;border-radius:11px;padding:12px 15px;background:var(--red);color:#fff;font-weight:700;cursor:pointer}button:disabled{opacity:.55}.secondary{background:#eef1f5;color:#303746}.hidden{display:none!important}.wrap{width:min(1180px,94%);margin:auto}header{height:68px;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}.top{height:100%;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:900;font-size:23px;letter-spacing:1.5px}.brand span{color:var(--red)}.muted{color:var(--muted);font-size:13px}main{padding:24px 0 60px}.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 7px 25px #18223508}.auth{max-width:440px;margin:35px auto}.auth h1{font-size:25px}.tag{display:inline-block;background:#fff0f0;color:var(--red);padding:7px 11px;border-radius:30px;font-size:11px;font-weight:800}label{display:block;font-size:13px;font-weight:700;margin:14px 0 7px}input,select,textarea{width:100%;border:1px solid #dce1e8;border-radius:10px;padding:13px;background:white;color:var(--ink)}textarea{min-height:95px;resize:vertical}.full{width:100%;margin-top:16px}.tabs{display:flex;gap:8px;margin:18px 0}.tabs button{flex:1;background:#eef1f5;color:#333}.tabs button.active{background:var(--red);color:white}.layout{display:grid;grid-template-columns:225px minmax(0,1fr);gap:18px}.sidebar{background:#fff;border:1px solid var(--line);border-radius:18px;padding:12px;height:max-content;position:sticky;top:84px}.nav{display:flex;align-items:center;gap:12px;width:100%;text-align:left;background:transparent;color:#465064;margin:3px 0}.nav.active{background:#fff0f0;color:var(--red)}.nav .ico{width:23px;text-align:center;font-size:18px}.maincol{min-width:0}.welcome{background:linear-gradient(120deg,#171b26,#343b49);color:white;border-radius:18px;padding:23px;margin-bottom:16px}.welcome p{color:#c6cbd4;margin:7px 0 0}.welcome h1{margin:10px 0 0;font-size:25px}.page{display:none}.page.active{display:block}.pagehead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:16px}.pagehead h2{margin:0;font-size:22px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:16px 0}.stat{background:#f8f9fb;border:1px solid var(--line);border-radius:13px;padding:15px}.stat b{display:block;font-size:22px;margin-top:7px}.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tile{border:1px solid var(--line);border-radius:14px;padding:17px;background:#fff;text-align:left;color:var(--ink)}.tile strong{display:block;margin:8px 0 4px}.tile .symbol{font-size:23px;color:var(--red)}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.pricebox{background:#fff3f3;border:1px solid #ffdada;border-radius:14px;padding:17px;margin-top:15px}.price{font-size:28px;font-weight:900;color:var(--red);margin-top:6px}.notice{background:#fff7e6;color:#79551c;padding:12px;border-radius:10px;font-size:13px;margin-top:14px}.message{padding:11px;border-radius:10px;background:#eaf7ef;color:#17633b;margin-top:12px;font-size:13px}.error{background:#ffecec;color:#a51d25}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line);font-size:13px}th{background:#f7f8fa}.item{border:1px solid var(--line);border-radius:13px;padding:14px;margin:10px 0}.row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.row>*{flex:1}.avatar{width:66px;height:66px;border-radius:50%;object-fit:cover;background:#eee}.status{display:inline-block;background:#fff4dc;color:#805b16;padding:5px 8px;border-radius:20px;font-size:11px;font-weight:700}.small{font-size:12px}
@media(max-width:760px){.layout{grid-template-columns:1fr}.sidebar{position:static;display:flex;overflow-x:auto;gap:4px;padding:8px}.nav{width:auto;white-space:nowrap;flex:0 0 auto;padding:10px}.nav .ico{width:auto}.stats{grid-template-columns:1fr 1fr}.tiles{grid-template-columns:1fr 1fr}.card{padding:16px}.welcome{padding:18px}}
@media(max-width:430px){.tiles,.grid2{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.brand{font-size:19px}}
</style>
</head>
<body>
<header><div class="wrap top"><div class="brand">T<span>A</span>MAL EXCHANGE</div><div class="row" style="justify-content:flex-end"><span id="userEmail" class="muted"></span><button id="logout" class="secondary hidden">Ka bax</button></div></div></header>
<main class="wrap">
<section id="authScreen" class="card auth">
<span class="tag">SARIF • LACAG DIRIS • ADEEG MACMIIL</span><h1>Ku soo dhowow TAMAL</h1><p class="muted">Gal akoonkaaga ama samee akoon cusub.</p>
<div class="tabs"><button id="loginTab" class="active">Soo gal</button><button id="signupTab">Akoon samee</button></div>
<label>Email / Gmail</label><input id="email" type="email" autocomplete="username" placeholder="magac@gmail.com">
<label>Password</label><input id="password" type="password" autocomplete="current-password" placeholder="Password">
<button id="authSubmit" class="full">Soo gal</button><div id="authMessage"></div>
</section>

<section id="profileSetup" class="card auth hidden"><span class="tag">TALLAABADA 1</span><h2>Dhammaystir Profile-kaaga</h2><p class="muted">Xogtan hal mar ayaad gelinaysaa. Mar dambe waxaad ka beddeli kartaa Profile.</p>
<label>Magaca oo buuxa</label><input id="newName" autocomplete="name">
<label>Lambarka telefoonka</label><input id="newPhone" autocomplete="tel" placeholder="+252...">
<label>Wallet ama mobile money (ikhtiyaari)</label><input id="newDefault" placeholder="EVC, E-Dahab, Zaad ama wallet">
<button id="saveNewProfile" class="full">Kaydi oo samee PIN</button><div id="setupMessage"></div></section>

<section id="pinScreen" class="card auth hidden"><span class="tag">AMMAANKA AKOONKA</span><h2 id="pinHeading">Xaqiiji PIN-kaaga</h2><p id="pinDescription" class="muted">Geli PIN-kaaga si aad u furto akoonkaaga.</p>
<label>PIN (4 ilaa 6 lambar)</label><input id="pinValue" type="password" inputmode="numeric" maxlength="6" autocomplete="one-time-code">
<button id="pinSubmit" class="full">Xaqiiji oo gal</button><div id="pinMessage"></div></section>

<section id="appScreen" class="hidden">
<div class="layout">
<aside class="sidebar">
<button class="nav active" data-page="home"><span class="ico">⌂</span> Home</button>
<button class="nav" data-page="exchange"><span class="ico">⇄</span> Exchange</button>
<button class="nav" data-page="transactions"><span class="ico">▤</span> Transactions</button>
<button class="nav" data-page="payments"><span class="ico">◈</span> Payment Methods</button>
<button class="nav" data-page="profile"><span class="ico">◉</span> Profile</button>
<button class="nav" data-page="support"><span class="ico">✉</span> Support</button>
<button id="adminNav" class="nav hidden" data-page="admin"><span class="ico">⚙</span> Admin</button>
</aside>
<div class="maincol">
<div class="welcome"><span class="tag">CUSTOMER PORTAL</span><h1 id="welcomeName">Dashboard</h1><p>Maamul sarifkaaga iyo dalabaadkaaga hal meel.</p></div>

<section id="page-home" class="page active">
<div class="pagehead"><h2>Home</h2><span class="muted">Guudmarka akoonka</span></div>
<div class="card"><div class="row"><img id="homeAvatar" class="avatar hidden" alt="Sawirka profile"><div><div class="muted">Ku soo dhowow</div><h2 id="homeName" style="margin:5px 0">Macmiil</h2><div class="muted" id="homePhone">—</div></div></div></div>
<div class="stats"><div class="stat">Dalabaadka oo dhan<b id="totalOrders">0</b></div><div class="stat">Sugaya<b id="pendingOrders">0</b></div><div class="stat">Dhammaystiran<b id="completedOrders">0</b></div></div>
<div class="pagehead"><h2>Quick Actions</h2></div>
<div class="tiles">
<button class="tile" data-go="exchange"><span class="symbol">⇄</span><strong>Samee sarif</strong><span class="muted">Bilow codsi cusub</span></button>
<button class="tile" data-go="transactions"><span class="symbol">▤</span><strong>Transactions</strong><span class="muted">La soco dalabaadkaaga</span></button>
<button class="tile" data-go="payments"><span class="symbol">◈</span><strong>Payment Methods</strong><span class="muted">Kaydi lambarrada iyo wallets</span></button>
<button class="tile" data-go="support"><span class="symbol">✉</span><strong>Support</strong><span class="muted">La xiriir maamulka</span></button>
</div>
<div class="card" style="margin-top:16px"><h3>Adeegyada TAMAL</h3><p class="muted">USDT, USD, EVC Plus, E-Dahab, Zaad, Sahal, Golis, Somnet iyo PayPal. Helitaanka adeeg kasta wuxuu ku xiran yahay qiimaha iyo xaqiijinta maamulka.</p></div>
</section>

<section id="page-exchange" class="page">
<div class="pagehead"><h2>Exchange</h2><span class="muted">Samee sarif cusub</span></div>
<div class="card">
<div class="grid2"><div><label>Waxaan dirayaa</label><select id="fromAsset"><option>USDT</option><option>USD</option><option>EVC Plus</option><option>E-Dahab</option><option>Zaad</option><option>Sahal</option><option>Golis</option><option>Somnet</option><option>PayPal</option></select></div><div><label>Waxaan helayaa</label><select id="toAsset"><option>USD</option><option>USDT</option><option>EVC Plus</option><option>E-Dahab</option><option>Zaad</option><option>Sahal</option><option>Golis</option><option>Somnet</option><option>PayPal</option></select></div></div>
<label>Qadarka aad dirayso</label><input id="amount" type="number" min="0" step="0.01" placeholder="Tusaale: 100">
<div class="pricebox"><div class="muted">Qiyaasta aad helayso (You Get)</div><div class="price" id="estimate">—</div><div class="muted" id="rateText">Qiimaha sarifka ayaa halkan ka muuqanaya.</div></div>
<label>Lambarka ama wallet address-ka qaataha</label><input id="recipient" placeholder="Geli lambarka / wallet address">
<label>Network (crypto haddii ay khusayso)</label><select id="network"><option>TRC20</option><option>BEP20</option><option>ERC20</option><option>Mobile Money</option><option>Not applicable</option></select>
<label>Faahfaahin (ikhtiyaari)</label><textarea id="orderDetails" placeholder="Faahfaahin dheeraad ah"></textarea>
<div class="notice">Foomkani wuxuu gudbinayaa codsi sarif. Lacag-bixinta dhabta ah waxaa lagu fuliyaa marka maamulka xaqiijiyo; app-kan kaligiis lacag ma wareejiyo.</div>
<button id="placeOrder" class="full">Gudbi codsiga sarifka</button><div id="orderMessage"></div>
</div></section>

<section id="page-transactions" class="page"><div class="pagehead"><h2>Transactions</h2><button id="refreshOrders" class="secondary">Cusboonaysii</button></div><div class="card tablewrap"><table><thead><tr><th>Taariikh</th><th>Diray</th><th>Helayo</th><th>Qadar</th><th>Xaalad</th><th>Faahfaahin</th></tr></thead><tbody id="transactionsBody"></tbody></table></div></section>

<section id="page-payments" class="page"><div class="pagehead"><h2>Payment Methods</h2><span class="muted">Hababka lacagtaada</span></div><div class="card"><h3>Ku dar hab cusub</h3><label>Magaca habka</label><input id="methodLabel" placeholder="EVC Plus / Binance TRC20"><label>Lambar ama Wallet Address</label><input id="methodValue" placeholder="Geli xogta"><button id="addMethod">Kaydi</button><div id="methodMessage"></div></div><div class="card"><h3>Hababka kaydsan</h3><div id="savedMethods"></div></div></section>

<section id="page-profile" class="page"><div class="pagehead"><h2>Profile</h2><span class="muted">Xogtaada gaarka ah</span></div><div class="card"><div class="row"><img id="profileAvatar" class="avatar hidden" alt="Profile photo"><div><b id="profileEmail"></b><p class="muted">Xogta profile-kaaga</p></div></div><label>Sawirka profile-ka</label><input id="avatarFile" type="file" accept="image/png,image/jpeg,image/webp"><label>Magaca oo buuxa</label><input id="profileName"><label>Lambarka telefoonka</label><input id="profilePhone"><label>Wallet / Mobile money default</label><input id="profileDefault"><button id="updateProfile">Kaydi isbeddelka</button><div id="profileMessage"></div></div></section>

<section id="page-support" class="page"><div class="pagehead"><h2>Support</h2><span class="muted">Caawinta macaamiisha</span></div><div class="card"><label>Mawduuca</label><input id="supportSubject" placeholder="Mawduuca fariinta"><label>Fariintaada</label><textarea id="supportText" placeholder="Sideen kuu caawin karnaa?"></textarea><button id="sendSupport">Dir fariinta</button><div id="supportMessage"></div></div><div class="card"><h3>Fariimahayga</h3><div id="supportHistory"></div></div></section>

<section id="page-admin" class="page"><div class="pagehead"><h2>Admin Dashboard</h2></div><div class="card"><h3>Dalabaadka macaamiisha</h3><div class="tablewrap"><table><thead><tr><th>Macmiil</th><th>Telefoon</th><th>Sarif</th><th>Qadar</th><th>Qaataha</th><th>Xaalad</th><th>Ficil</th></tr></thead><tbody id="adminOrders"></tbody></table></div></div><div class="card"><h3>Deji qiimaha sarifka</h3><div class="grid2"><div><label>From</label><select id="rateFrom"></select></div><div><label>To</label><select id="rateTo"></select></div><div><label>Rate</label><input id="rateValue" type="number" step="0.000001"></div><div><label>Fee %</label><input id="rateFee" type="number" step="0.01" value="1"></div></div><button id="saveRate">Kaydi qiimaha</button><div id="rateMessage"></div></div><div class="card"><h3>Taageerada macaamiisha</h3><div id="adminSupport"></div></div></section>
</div></div></section>
</main>
<script>
const SUPABASE_URL='https://peozafoxwycjareoexkq.supabase.co';
const SUPABASE_KEY='sb_publishable_HSDiVJuamI5dL3mC-9cuuw_wOmO1wvd';
const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
const $=id=>document.getElementById(id);
let user=null,profile=null,role='customer',authMode='login',pinMode='verify',rates=[];
const assets=['USDT','USD','EVC Plus','E-Dahab','Zaad','Sahal','Golis','Somnet','PayPal'];
function screen(id){['authScreen','profileSetup','pinScreen','appScreen'].forEach(x=>$(x).classList.toggle('hidden',x!==id))}
function note(id,msg,error=false){$(id).innerHTML='<div class="message '+(error?'error':'')+'">'+escapeHtml(msg)+'</div>'}
function escapeHtml(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function page(name){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id==='page-'+name));document.querySelectorAll('[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===name));if(name==='home')loadHome();if(name==='transactions')loadTransactions();if(name==='payments')loadMethods();if(name==='support')loadSupport();if(name==='admin')loadAdmin()}
document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',()=>page(b.dataset.page)));
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>page(b.dataset.go)));
$('loginTab').onclick=()=>{authMode='login';$('loginTab').classList.add('active');$('signupTab').classList.remove('active');$('authSubmit').textContent='Soo gal';$('password').autocomplete='current-password'};
$('signupTab').onclick=()=>{authMode='signup';$('signupTab').classList.add('active');$('loginTab').classList.remove('active');$('authSubmit').textContent='Samee akoon';$('password').autocomplete='new-password'};
$('authSubmit').onclick=async()=>{let email=$('email').value.trim(),password=$('password').value;if(!email||!password)return note('authMessage','Geli email iyo password.',true);$('authSubmit').disabled=true;try{let r=authMode==='signup'?await sb.auth.signUp({email,password}):await sb.auth.signInWithPassword({email,password});if(r.error)throw r.error;if(authMode==='signup'&&!r.data.session){note('authMessage','Akoonka waa la sameeyay. Xaqiiji email-kaaga, kadib soo gal.');return}user=r.data.user;await afterAuth()}catch(e){note('authMessage',e.message,true)}finally{$('authSubmit').disabled=false}};
async function afterAuth(){let pr=await sb.from('profiles').select('role').eq('id',user.id).maybeSingle();role=pr.data?.role||'customer';let cp=await sb.from('customer_profiles').select('*').eq('user_id',user.id).maybeSingle();if(cp.error){note('authMessage','Database-ka customer_profiles lama helin. Fadlan marka hore SQL setup-ka socodsii.',true);screen('authScreen');return}profile=cp.data;$('userEmail').textContent=user.email;$('profileEmail').textContent=user.email;$('logout').classList.remove('hidden');if(!profile||!profile.full_name||!profile.phone){$('newName').value=profile?.full_name||'';$('newPhone').value=profile?.phone||'';$('newDefault').value=profile?.default_address||'';screen('profileSetup');return}showPin('verify')}
function showPin(mode){pinMode=mode;$('pinValue').value='';$('pinHeading').textContent=mode==='create'?'Sameyso PIN-kaaga':'Geli PIN-kaaga';$('pinDescription').textContent=mode==='create'?'Sameyso PIN 4 ilaa 6 lambar ah.':'PIN-kaaga geli si aad u furto Dashboard-ka.';$('pinSubmit').textContent=mode==='create'?'Kaydi PIN':'Xaqiiji oo gal';screen('pinScreen')}
$('saveNewProfile').onclick=async()=>{let full_name=$('newName').value.trim(),phone=$('newPhone').value.trim(),default_address=$('newDefault').value.trim();if(!full_name||!phone)return note('setupMessage','Magaca iyo telefoonka waa waajib.',true);let r=await sb.from('customer_profiles').upsert({user_id:user.id,full_name,phone,default_address,updated_at:new Date().toISOString()},{onConflict:'user_id'});if(r.error)return note('setupMessage',r.error.message,true);profile={...(profile||{}),user_id:user.id,full_name,phone,default_address};showPin('create')};
$('pinSubmit').onclick=async()=>{let pin=$('pinValue').value;if(!/^\d{4,6}$/.test(pin))return note('pinMessage','PIN-ku waa inuu ka koobnaadaa 4 ilaa 6 lambar.',true);$('pinSubmit').disabled=true;try{let r=await sb.rpc(pinMode==='create'?'set_my_pin':'verify_my_pin',{p_pin:pin});if(r.error)throw r.error;if(pinMode==='verify'&&!(r.data===true||r.data?.verified===true||r.data?.success===true))throw Error('PIN-ka aad gelisay sax ma aha.');screen('appScreen');await openApp()}catch(e){note('pinMessage',e.message||'PIN lama xaqiijin.',true)}finally{$('pinSubmit').disabled=false}};
$('pinValue').addEventListener('keydown',e=>{if(e.key==='Enter')$('pinSubmit').click()});
async function openApp(){ $('welcomeName').textContent='Ku soo dhowow, '+(profile.full_name||'Macmiil');$('homeName').textContent=profile.full_name||'Macmiil';$('homePhone').textContent=profile.phone||'—';$('profileName').value=profile.full_name||'';$('profilePhone').value=profile.phone||'';$('profileDefault').value=profile.default_address||'';$('adminNav').classList.toggle('hidden',!['admin','staff'].includes(role));if(profile.avatar_url){$('homeAvatar').src=profile.avatar_url;$('homeAvatar').classList.remove('hidden');$('profileAvatar').src=profile.avatar_url;$('profileAvatar').classList.remove('hidden')}for(let id of ['rateFrom','rateTo'])$(id).innerHTML=assets.map(a=>`<option>${a}</option>`).join('');await loadRates();await loadHome();page('home')}
async function loadHome(){let r=await sb.from('orders').select('status').eq('user_id',user.id);let rows=r.data||[];$('totalOrders').textContent=rows.length;$('pendingOrders').textContent=rows.filter(x=>x.status==='pending').length;$('completedOrders').textContent=rows.filter(x=>x.status==='completed').length}
async function loadRates(){let r=await sb.from('exchange_rates').select('*');rates=r.data||[];calculate()}
function calculate(){let a=$('fromAsset').value,b=$('toAsset').value,n=Number($('amount').value),rate=rates.find(x=>x.from_asset===a&&x.to_asset===b);if(!n||n<=0||!rate){$('estimate').textContent='Qiime lama hayo';$('rateText').textContent='Maamulka ayaa dejinaya qiimaha labada lacagood.';return}let fee=Number(rate.fee_percent||0),out=n*Number(rate.rate)*(1-fee/100);$('estimate').textContent=out.toFixed(2)+' '+b;$('rateText').textContent='Rate: '+rate.rate+' · Khidmad: '+fee+'%'}
['fromAsset','toAsset','amount'].forEach(id=>$(id).addEventListener('input',calculate));
$('placeOrder').onclick=async()=>{let amount=Number($('amount').value),recipient=$('recipient').value.trim();if(!amount||amount<=0||!recipient)return note('orderMessage','Geli qadar sax ah iyo lambarka ama wallet address-ka.',true);let r=await sb.from('orders').insert({user_id:user.id,from_asset:$('fromAsset').value,to_asset:$('toAsset').value,amount,network:$('network').value,recipient,details:$('orderDetails').value.trim(),status:'pending'});if(r.error)return note('orderMessage',r.error.message,true);note('orderMessage','Codsiga sarifka waa la gudbiyey.');$('amount').value='';$('recipient').value='';$('orderDetails').value='';await loadHome()};
async function loadTransactions(){let r=await sb.from('orders').select('*').eq('user_id',user.id).order('created_at',{ascending:false});$('transactionsBody').innerHTML=(r.data||[]).map(o=>`<tr><td>${new Date(o.created_at).toLocaleString()}</td><td>${escapeHtml(o.from_asset)}</td><td>${escapeHtml(o.to_asset)}</td><td>${escapeHtml(o.amount)}</td><td><span class="status">${escapeHtml(o.status)}</span></td><td>${escapeHtml(o.admin_note||o.details||'—')}</td></tr>`).join('')||'<tr><td colspan="6">Weli transaction ma lihid.</td></tr>'}
$('refreshOrders').onclick=loadTransactions;
$('addMethod').onclick=async()=>{let label=$('methodLabel').value.trim(),value=$('methodValue').value.trim();if(!label||!value)return note('methodMessage','Buuxi magaca habka iyo xogtiisa.',true);let r=await sb.from('saved_methods').insert({user_id:user.id,label,value});if(r.error)return note('methodMessage',r.error.message,true);$('methodLabel').value='';$('methodValue').value='';note('methodMessage','Habka waa la kaydiyey.');loadMethods()};
async function loadMethods(){let r=await sb.from('saved_methods').select('*').eq('user_id',user.id).order('created_at',{ascending:false});$('savedMethods').innerHTML=(r.data||[]).map(m=>`<div class="item"><b>${escapeHtml(m.label)}</b><p>${escapeHtml(m.value)}</p><button class="secondary" data-delete-method="${m.id}">Tirtir</button></div>`).join('')||'<p class="muted">Weli hab lacag lama kaydin.</p>';document.querySelectorAll('[data-delete-method]').forEach(b=>b.onclick=async()=>{let z=await sb.from('saved_methods').delete().eq('id',b.dataset.deleteMethod);if(z.error)alert(z.error.message);else loadMethods()})}
$('updateProfile').onclick=async()=>{let full_name=$('profileName').value.trim(),phone=$('profilePhone').value.trim(),default_address=$('profileDefault').value.trim();if(!full_name||!phone)return note('profileMessage','Magaca iyo telefoonka waa waajib.',true);let r=await sb.from('customer_profiles').update({full_name,phone,default_address,updated_at:new Date().toISOString()}).eq('user_id',user.id);if(r.error)return note('profileMessage',r.error.message,true);profile={...profile,full_name,phone,default_address};$('homeName').textContent=full_name;$('homePhone').textContent=phone;$('welcomeName').textContent='Ku soo dhowow, '+full_name;note('profileMessage','Xogta profile-ka waa la cusboonaysiiyey.')};
$('avatarFile').onchange=async()=>{let file=$('avatarFile').files[0];if(!file)return;if(file.size>3*1024*1024)return note('profileMessage','Sawirku waa inuu ka yaraadaa 3MB.',true);let ext=file.name.split('.').pop().toLowerCase(),path=user.id+'/'+Date.now()+'.'+ext;let up=await sb.storage.from('customer-photos').upload(path,file,{upsert:true,contentType:file.type});if(up.error)return note('profileMessage',up.error.message,true);let pub=sb.storage.from('customer-photos').getPublicUrl(path).data.publicUrl;let saved=await sb.from('customer_profiles').update({avatar_url:pub,updated_at:new Date().toISOString()}).eq('user_id',user.id);if(saved.error)return note('profileMessage',saved.error.message,true);profile.avatar_url=pub;$('profileAvatar').src=pub;$('homeAvatar').src=pub;$('profileAvatar').classList.remove('hidden');$('homeAvatar').classList.remove('hidden');note('profileMessage','Sawirka profile-ka waa la kaydiyey.')};
$('sendSupport').onclick=async()=>{let message=$('supportText').value.trim();if(!message)return note('supportMessage','Qor fariintaada.',true);let r=await sb.from('support_messages').insert({user_id:user.id,subject:$('supportSubject').value.trim(),message});if(r.error)return note('supportMessage',r.error.message,true);$('supportText').value='';note('supportMessage','Fariinta waa la diray.');loadSupport()};
async function loadSupport(){let r=await sb.from('support_messages').select('*').eq('user_id',user.id).order('created_at',{ascending:false});$('supportHistory').innerHTML=(r.data||[]).map(m=>`<div class="item"><b>${escapeHtml(m.subject||'Taageero')}</b><p>${escapeHtml(m.message)}</p><span class="status">${escapeHtml(m.status)}</span>${m.admin_reply?'<p><b>Jawaabta maamulka:</b> '+escapeHtml(m.admin_reply)+'</p>':''}</div>`).join('')||'<p class="muted">Weli fariin ma dirin.</p>'}
async function loadAdmin(){let [orders,customers,support]=await Promise.all([sb.from('orders').select('*').order('created_at',{ascending:false}).limit(200),sb.from('customer_profiles').select('*'),sb.from('support_messages').select('*').order('created_at',{ascending:false}).limit(100)]);if(orders.error||customers.error||support.error){$('adminOrders').innerHTML='<tr><td colspan="7">Maamulka ma heli karo xogta. Hubi RLS policies.</td></tr>';return}let people=customers.data||[];let getPerson=id=>people.find(p=>p.user_id===id)||{};$('adminOrders').innerHTML=(orders.data||[]).map(o=>{let c=getPerson(o.user_id);return `<tr><td>${escapeHtml(c.full_name||'Macmiil')}</td><td>${escapeHtml(c.phone||'—')}</td><td>${escapeHtml(o.from_asset)} → ${escapeHtml(o.to_asset)}</td><td>${escapeHtml(o.amount)}</td><td>${escapeHtml(o.recipient)}</td><td>${escapeHtml(o.status)}</td><td><select id="status-${o.id}"><option value="pending">pending</option><option value="processing">processing</option><option value="completed">completed</option><option value="rejected">rejected</option></select><button data-save-order="${o.id}">Kaydi</button></td></tr>`}).join('')||'<tr><td colspan="7">Dalab ma jiro.</td></tr>';document.querySelectorAll('[data-save-order]').forEach(b=>b.onclick=async()=>{let id=b.dataset.saveOrder,status=$('status-'+id).value;let r=await sb.from('orders').update({status,updated_at:new Date().toISOString()}).eq('id',id);if(r.error)alert(r.error.message);else{loadAdmin();loadHome()}});$('adminSupport').innerHTML=(support.data||[]).map(m=>`<div class="item"><b>${escapeHtml(getPerson(m.user_id).full_name||'Macmiil')}</b><p>${escapeHtml(m.subject||'')}: ${escapeHtml(m.message)}</p><label>Jawaabta maamulka</label><input id="reply-${m.id}" value="${escapeHtml(m.admin_reply||'')}"><button data-reply="${m.id}">Dir jawaab</button></div>`).join('')||'<p class="muted">Fariimo ma jiraan.</p>';document.querySelectorAll('[data-reply]').forEach(b=>b.onclick=async()=>{let id=b.dataset.reply,r=await sb.from('support_messages').update({admin_reply:$('reply-'+id).value,status:'answered'}).eq('id',id);if(r.error)alert(r.error.message);else loadAdmin()})}
$('saveRate').onclick=async()=>{let from_asset=$('rateFrom').value,to_asset=$('rateTo').value,rate=Number($('rateValue').value),fee_percent=Number($('rateFee').value||0);if(from_asset===to_asset||rate<=0||fee_percent<0)return note('rateMessage','Hubi lacagaha, rate-ka iyo fee-ga.',true);let r=await sb.from('exchange_rates').upsert({from_asset,to_asset,rate,fee_percent,updated_at:new Date().toISOString()},{onConflict:'from_asset,to_asset'});if(r.error)return note('rateMessage',r.error.message,true);note('rateMessage','Qiimaha waa la kaydiyey.');await loadRates()};
$('logout').onclick=async()=>{await sb.auth.signOut();location.reload()};
(async()=>{let s=await sb.auth.getSession();if(s.data.session){user=s.data.session.user;await afterAuth()}})();
</script>
</body></html>
